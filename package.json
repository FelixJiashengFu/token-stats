{
  "name": "@jiashengfu/token-stats",
  "version": "1.8.1",
  "type": "module",
  "description": "A DeepSeek Harness dashboard for real session token usage, per-session costs, monthly budgets, and CPU/memory monitoring.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "stats-core.js",
    "stats-pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "INSTALL.md",
    "CHANGELOG.md",
    "docs/banner.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FelixJiashengFu/token-stats.git"
  },
  "homepage": "https://github.com/FelixJiashengFu/token-stats#readme",
  "bugs": {
    "url": "https://github.com/FelixJiashengFu/token-stats/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-usage",
    "cost-tracking",
    "budget",
    "monitoring"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
