{
  "name": "@local/token-stats",
  "version": "1.8.1",
  "private": true,
  "type": "module",
  "description": "Real session statistics: total token usage, session counts, estimated cost and monthly budget, token timeline, per-session usage/cost, and host CPU monitoring — all folded from your actual session logs.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "stats-core.js",
    "stats-pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}